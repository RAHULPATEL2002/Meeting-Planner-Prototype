# Copy to backend/.env and adjust. Every value has a working default, so the
# app runs from a fresh checkout without this file.

# Secret used to sign JWTs. MUST be overridden outside local development.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=insecure-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite file location (relative paths are resolved against the process CWD).
# DATABASE_URL=sqlite:///./meeting_planner.db

# Where uploaded avatars are written.
# UPLOAD_DIR=./uploads
# AVATAR_MAX_BYTES=2097152

# JSON array of allowed browser origins.
# CORS_ORIGINS=["http://localhost:4200"]

ENVIRONMENT=development
